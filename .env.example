# Copy to .env and fill in what you have. Everything is optional: with nothing
# set, JARVIS starts, shows each link as offline, and says exactly why.

PORT=3000
HOST=127.0.0.1
# The address you open in the browser. Google redirects back to
# PUBLIC_URL/auth/google/callback, so register that exact URI.
PUBLIC_URL=http://localhost:3000
# Require a password (HTTP Basic, any username). Set this on any hosted install
# that has real accounts connected.
ACCESS_PASSWORD=

# Google Calendar + Drive (OAuth web client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Optional starting contacts: Name=chat_id, comma separated (groups are negative)
TELEGRAM_CONTACTS=

# Language model for understanding orders. Without a key the built-in parser is used.
ANTHROPIC_API_KEY=
# Leave empty to pick a mid-tier model automatically, or name one explicitly.
ANTHROPIC_MODEL=

# Largest file the console will accept for Drive upload
MAX_UPLOAD_MB=200

# Run entirely on built-in simulated Calendar/Drive/Telegram (no accounts needed).
# Nothing is saved. Same as `npm run demo`.
# JARVIS_DEMO=1
